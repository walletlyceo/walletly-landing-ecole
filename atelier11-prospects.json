      "id": "b0000000-0000-4000-8000-000000000010",
      "name": "Formulaire de recherche",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "4f6c2b1e-9a7d-4c3e-8b5a-1d2e3f4a5b6c"
    },
    {
      "parameters": {
        "jsCode": "// Une recherche Google par zone et par type de commerce, d'après le formulaire\nconst f = $input.first().json;\nconst TOUS = [\"Boulangerie\",\"Pâtisserie\",\"Café\",\"Salon de thé\",\"Restaurant\",\"Bar\",\"Coiffeur\",\"Barbier\",\"Institut de beauté\",\"Onglerie\",\"Fleuriste\",\"Caviste\",\"Boucherie\",\"Fromagerie\",\"Épicerie fine\"];\nconst nettoyer = s => s.map(x => String(x).trim()).filter(Boolean);\nconst zones = nettoyer(String(f['Zones'] || '').split(String.fromCharCode(10)).join(';').split(';'));\nlet types = f['Types de commerce'] || [];\nif (!Array.isArray(types)) types = [types];\nif (types.includes(\"Tous les commerces\")) types = TOUS;\nconst autres = nettoyer(String(f['Autres types (facultatif)'] || '').split(','));\nconst categories = [...new Set([...types.filter(t => t !== \"Tous les commerces\"), ...autres].map(t => t.toLowerCase()))];\nif (!zones.length) throw new Error('Indique au moins une zone.');\nif (!categories.length) throw new Error('Choisis au moins un type de commerce.');\nconst nb = zones.length * categories.length;\nif (nb > 150) throw new Error(nb + ' recherches demandées : maximum 150 par lancement (quota gratuit Google de 1000/mois). Réduis les zones ou les types.');\nconst recherches = [];\nfor (const zone of zones) {\n  for (const categorie of categories) {\n    recherches.push({ json: { categorie, zone, textQuery: categorie + ' ' + zone } });\n  }\n}\nreturn recherches;"
      },
      "id": "b0000000-0000-4000-8000-000000000003",
      "name": "Préparer les recherches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://places.googleapis.com/v1/places:searchText",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Goog-FieldMask",
              "value": "places.id,places.displayName,places.formattedAddress,places.rating,places.userRatingCount,places.websiteUri,places.nationalPhoneNumber,places.googleMapsUri,places.businessStatus"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ textQuery: $json.textQuery, languageCode: 'fr', regionCode: 'FR', pageSize: 20 }) }}",
        "options": {}
      },
      "id": "b0000000-0000-4000-8000-000000000004",
      "name": "Recherche Google Places",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YdC9yNAEjN9Iy9QG",
          "name": "Google Places API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Fusionne les résultats, écarte doublons et commerces fermés, calcule le potentiel\nconst recherches = $('Préparer les recherches').all();\nconst vus = new Set();\nconst sortie = [];\nconst maintenant = $now.toFormat('yyyy-MM-dd HH:mm');\n\n$input.all().forEach((item, i) => {\n  const r = (recherches[item.pairedItem?.item ?? i] || {}).json || {};\n  for (const p of item.json.places || []) {\n    if (vus.has(p.id)) continue;\n    if (p.businessStatus && p.businessStatus !== 'OPERATIONAL') continue;\n    vus.add(p.id);\n\n    const note = typeof p.rating === 'number' ? p.rating : null;\n    const nb = p.userRatingCount || 0;\n    let potentiel, raison;\n    if (nb < 100) { potentiel = '1 - Fort'; raison = \"Peu d'avis Google (\" + nb + ')'; }\n    else if (note !== null && note < 4.3) { potentiel = '1 - Fort'; raison = 'Note à améliorer (' + note + ')'; }\n    else if (nb < 300) { potentiel = '2 - Moyen'; raison = \"Nombre d'avis moyen (\" + nb + ')'; }\n    else { potentiel = '3 - Faible'; raison = \"Déjà beaucoup d'avis (\" + nb + ')'; }\n\n    sortie.push({ json: {\n      place_id: p.id,\n      nom: (p.displayName && p.displayName.text) || '',\n      categorie: r.categorie || '',\n      potentiel,\n      raison,\n      note: note === null ? '' : note,\n      nb_avis: nb,\n      adresse: p.formattedAddress || '',\n      telephone: p.nationalPhoneNumber || '',\n      site_web: p.websiteUri || '',\n      google_maps: p.googleMapsUri || '',\n      zone: r.zone || '',\n      maj_le: maintenant,\n    } });\n  }\n});\n\nsortie.sort((a, b) => a.json.potentiel.localeCompare(b.json.potentiel) || a.json.nb_avis - b.json.nb_avis);\nreturn sortie;"
      },
